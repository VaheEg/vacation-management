# Local development defaults. Copy to .env (scripts/dev-up.sh does it for you).
# These values are for a developer machine only; never reuse them elsewhere.

POSTGRES_PASSWORD=postgres_local
ORG_DB_PASSWORD=org_local
LEAVE_DB_PASSWORD=leave_local
APPROVAL_DB_PASSWORD=approval_local
NOTIFY_DB_PASSWORD=notify_local
KEYCLOAK_DB_PASSWORD=keycloak_local

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
KEYCLOAK_PROVISIONER_SECRET=provisioner_local_secret

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_local_password
